{
  "name": "dt-presentation-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src data docs prompts tests *.js *.json *.html README.md",
    "export:demo": "node scripts/export-demo.js",
    "export:html": "npm run build && node scripts/export-standalone.js"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "jszip": "^3.10.1",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
